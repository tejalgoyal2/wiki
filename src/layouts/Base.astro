---
import { ClientRouter } from "astro:transitions"
import "@fontsource-variable/literata"
import "@fontsource-variable/literata/wght-italic.css"
import "@fontsource-variable/geist"
import "@fontsource-variable/geist-mono"
import "@fontsource-variable/bricolage-grotesque"
import "../styles/global.css"
import { lessons } from "../lib/wiki"

interface Props {
  title?: string
  description?: string
  slug?: string
  home?: boolean
}
const { title, description = "A wiki where every term opens its own note. Search anything, keep digging.", slug, home } = Astro.props
const full = title ? `${title} · Wiki` : "Wiki · search a term, keep digging"

// [name, label, background, accent] for the swatches in the options panel. The real colours live in global.css.
const MOODS = [
  ["paper", "Paper", "#faf9f6", "#0f7285"],
  ["ink", "Ink", "#0d0f16", "#7fd4e4"],
  ["dusk", "Dusk", "#2a1830", "#ffb38a"],
  ["candy", "Candy", "#fdeef4", "#e0358f"],
  ["mint", "Mint", "#ebf8f1", "#0c7a5c"],
  ["terminal", "Terminal", "#07100a", "#5dfa8a"],
]
const KEYS = [
  ["/", "Search (also ⌘K)"],
  ["r", "Surprise me: a random note"],
  ["d", "Today's read"],
  ["h", "Home"],
  ["w", "Wanted terms"],
  ["]  [", "Walk through the terms on this page"],
  ["←", "Back one step in the side trail"],
  ["o", "Open the note in the side trail"],
  ["esc", "Close the side trail"],
  ["u", "Mark this note understood"],
  ["a", "Open or close every answer"],
  ["f", "Focus: hide everything but the text"],
  ["t", "Next mood"],
  [",", "Options"],
  ["?", "This list"],
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <link rel="icon" href="/icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Lessons" href="/rss.xml" />
    <script is:inline>
      // Before first paint: the reader's mood, font and size. "auto" follows the system.
      try {
        const p = JSON.parse(localStorage.getItem("wiki:prefs")) || {}
        const r = document.documentElement
        r.dataset.theme = p.theme && p.theme !== "auto" ? p.theme : matchMedia("(prefers-color-scheme: dark)").matches ? "ink" : "paper"
        if (p.font) r.dataset.font = p.font
        if (p.size) r.dataset.size = p.size
      } catch {}
    </script>
    <ClientRouter />
  </head>
  <body data-slug={slug} data-title={title} data-today={lessons[0]?.url} class:list={{ home }}>
    <div class="progress" aria-hidden="true"></div>
    <header class="top">
      <a class="mark" href="/" aria-label="Wiki home">
        <i></i><b>Wiki</b><span data-tag>rabbit holes welcome</span>
      </a>
      {
        !home && (
          <button class="search-open" type="button" data-open-search>
            <span>Search a term</span>
            <kbd>/</kbd>
          </button>
        )
      }
      <button class="icon" type="button" data-open-keys aria-label="Keyboard shortcuts"><kbd>?</kbd></button>
      <button class="icon theme" type="button" data-open-prefs aria-label="Options: mood, font, size"><i></i></button>
    </header>

    <slot />

    <footer class="foot">
      <nav>
        <a href="/glossary/">Glossary</a>
        <a href="/practice/">Practice</a>
        <a href="/quiz/" data-astro-reload>Quiz</a>
        <a href="/traps/">Traps</a>
        <a href="/wanted/">Wanted</a>
        <a href="/about/">About</a>
        <a href="/rss.xml" data-astro-reload>RSS</a>
      </nav>
      <p>Written from primary sources, with code that is run before it is published. Text CC BY 4.0.</p>
    </footer>

    <dialog id="palette" aria-label="Search">
      <div class="q">
        <input type="search" placeholder="Search a term" autocomplete="off" spellcheck="false" aria-label="Search a term" />
        <ul class="results" role="listbox"></ul>
      </div>
    </dialog>

    <dialog id="prefs" class="sheet" aria-label="Options">
      <div class="panel">
        <h2>Make it yours</h2>
        <p class="kicker">Mood</p>
        <div class="opts moods">
          <button type="button" data-pref="theme" data-value="auto"><i style="background:linear-gradient(135deg,#faf9f6 50%,#0d0f16 50%)"></i>Auto</button>
          {
            MOODS.map(([name, label, bg, accent]) => (
              <button type="button" data-pref="theme" data-value={name}>
                <i style={`background:linear-gradient(135deg,${bg} 50%,${accent} 50%)`} />
                {label}
              </button>
            ))
          }
        </div>
        <p class="kicker">Reading font</p>
        <div class="opts">
          <button type="button" data-pref="font" data-value="serif" style="font-family:var(--book)">Bookish</button>
          <button type="button" data-pref="font" data-value="sans" style="font-family:var(--ui)">Clean</button>
          <button type="button" data-pref="font" data-value="mono" style="font-family:var(--mono)">Hacker</button>
        </div>
        <p class="kicker">Text size</p>
        <div class="opts">
          <button type="button" data-pref="size" data-value="s">Small</button>
          <button type="button" data-pref="size" data-value="m">Medium</button>
          <button type="button" data-pref="size" data-value="l">Large</button>
        </div>
        <p class="kicker">Clicking a term</p>
        <div class="opts">
          <button type="button" data-pref="open" data-value="side">Opens beside the page</button>
          <button type="button" data-pref="open" data-value="page">Goes to its page</button>
        </div>
        <p class="kicker">Map on the home page</p>
        <div class="opts">
          <button type="button" data-pref="motion" data-value="on">Drifting</button>
          <button type="button" data-pref="motion" data-value="off">Still</button>
        </div>
        <p class="hint">Saved in this browser. Press <kbd>t</kbd> anywhere to flip through moods.</p>
      </div>
    </dialog>

    <dialog id="keys" class="sheet" aria-label="Keyboard shortcuts">
      <div class="panel">
        <h2>Keys</h2>
        <dl>
          {
            KEYS.map(([key, what]) => (
              <>
                <dt>{key.split("  ").map((k) => <kbd>{k}</kbd>)}</dt>
                <dd>{what}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </dialog>

    <aside id="peek" aria-label="Side trail">
      <header>
        <nav class="crumbs" aria-label="Your trail"></nav>
        <span class="depth" data-depth></span>
        <button type="button" data-peek-close aria-label="Close">esc</button>
      </header>
      <div class="peek-body prose"></div>
    </aside>

    <script>
      import "../scripts/app.ts"
    </script>
  </body>
</html>
