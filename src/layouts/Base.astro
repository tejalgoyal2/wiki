---
import { ClientRouter } from "astro:transitions"
import "@fontsource-variable/newsreader/opsz.css"
import "@fontsource-variable/newsreader/opsz-italic.css"
import "@fontsource-variable/geist"
import "@fontsource-variable/geist-mono"
import "../styles/global.css"
import { lessons } from "../lib/wiki"

interface Props {
  title?: string
  description?: string
  slug?: string
  home?: boolean
}
const { title, description = "A wiki where every term opens its own note. Search anything, keep digging.", slug, home } = Astro.props
const full = title ? `${title} · Wiki` : "Wiki · a note for every term"

const KEYS = [
  ["/", "Search (also ⌘K)"],
  ["]  [", "Unfold the next or previous term on the page"],
  ["esc", "Fold the last thing you unfolded"],
  ["r", "A random note"],
  ["d", "Today's read"],
  ["h", "Home"],
  ["w", "Wanted terms"],
  ["u", "Mark this note understood"],
  ["a", "Reveal or hide every answer"],
  ["f", "Focus: only the text"],
  ["t", "Next paper"],
  [",", "Options"],
  ["?", "This list"],
]
const OPTIONS: [string, string, [string, string][]][] = [
  ["Paper", "theme", [["auto", "Auto"], ["paper", "Paper"], ["sand", "Sand"], ["night", "Night"]]],
  ["Reading face", "font", [["serif", "Serif"], ["sans", "Sans"]]],
  ["Text size", "size", [["s", "Small"], ["m", "Medium"], ["l", "Large"]]],
  ["Clicking a term", "open", [["unfold", "Unfolds it in place"], ["page", "Goes to its page"]]],
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <link rel="icon" href="/icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Lessons" href="/rss.xml" />
    <script is:inline>
      // Before first paint: the reader's paper, face and size. "auto" follows the system.
      try {
        const p = JSON.parse(localStorage.getItem("wiki:prefs")) || {}
        const r = document.documentElement
        const ok = ["paper", "sand", "night"].includes(p.theme)
        r.dataset.theme = ok ? p.theme : matchMedia("(prefers-color-scheme: dark)").matches ? "night" : "paper"
        if (p.font) r.dataset.font = p.font
        if (p.size) r.dataset.size = p.size
      } catch {}
    </script>
    <ClientRouter />
  </head>
  <body data-slug={slug} data-title={title} data-today={lessons[0]?.url}>
    {!home && <div class="progress" aria-hidden="true" />}
    <header class="top">
      <a class="mark" href="/" aria-label="Wiki home">
        <!-- ※ the reference mark: "see the note" -->
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5.5 5.5l13 13M18.5 5.5l-13 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
          <circle cx="12" cy="4" r="1.8"></circle><circle cx="12" cy="20" r="1.8"></circle>
          <circle cx="4" cy="12" r="1.8"></circle><circle cx="20" cy="12" r="1.8"></circle>
        </svg>
        <b>Wiki</b><span>a note for every term</span>
      </a>
      <nav class="tools">
        {!home && <button type="button" data-open-search>Search <kbd>/</kbd></button>}
        <button type="button" data-open-keys>Keys <kbd>?</kbd></button>
        <button type="button" data-open-prefs>Options</button>
      </nav>
    </header>

    <slot />

    <footer class="foot">
      <nav>
        <a href="/glossary/">Glossary</a>
        <a href="/practice/">Practice</a>
        <a href="/quiz/" data-astro-reload>Quiz</a>
        <a href="/traps/">Traps</a>
        <a href="/wanted/">Wanted</a>
        <a href="/about/">About</a>
        <a href="/rss.xml" data-astro-reload>RSS</a>
      </nav>
      <p>Written from primary sources, with code that is run before it is published. Text CC BY 4.0.</p>
    </footer>

    <dialog id="palette" aria-label="Search">
      <div class="q">
        <label for="pq">What do you want to understand?</label>
        <div class="q-line">
          <input id="pq" type="search" placeholder="a term" autocomplete="off" spellcheck="false" />
        </div>
        <ul class="results" role="listbox"></ul>
      </div>
    </dialog>

    <dialog id="prefs" class="sheet" aria-label="Options">
      <div class="panel">
        <h2>Options</h2>
        {
          OPTIONS.map(([label, key, values]) => (
            <>
              <h3>{label}</h3>
              <div class="opts">
                {values.map(([value, name]) => (
                  <button type="button" data-pref={key} data-value={value}>
                    {name}
                  </button>
                ))}
              </div>
            </>
          ))
        }
        <p class="hint">Kept in this browser. <kbd>t</kbd> flips the paper from anywhere.</p>
      </div>
    </dialog>

    <dialog id="keys" class="sheet" aria-label="Keyboard shortcuts">
      <div class="panel">
        <h2>Keys</h2>
        <dl>
          {
            KEYS.map(([key, what]) => (
              <>
                <dt>{key.split("  ").map((k) => <kbd>{k}</kbd>)}</dt>
                <dd>{what}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </dialog>

    <script>
      import "../scripts/app.ts"
    </script>
  </body>
</html>
