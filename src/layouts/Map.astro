---
// The whole site is one page: a map of every note that you fly around.
// A note's own address (/concepts/thread/) serves this same page, already at that card.
import "@fontsource-variable/figtree"
import "@fontsource-variable/geist-mono"
import "../styles/global.css"
import { cardBody, type Note } from "../lib/wiki"

interface Props {
  note?: Note
  lost?: boolean
}
const { note, lost } = Astro.props
const title = note ? `${note.title} · Wiki` : "Wiki · a map of things worth understanding"
const description = note?.lead ?? "A map of software, data and ML. Every term is a place; click one and fly there."

const KEYS = [
  ["/", "Search the map (also ⌘K)"],
  ["esc", "Step back out to the map"],
  ["]", "Fly to the next linked note you haven't opened"],
  ["[", "Fly back the way you came"],
  ["r", "Fly somewhere random"],
  ["d", "Today's read"],
  ["0", "See the whole map"],
  ["+  −", "Zoom in and out"],
  ["← ↑ ↓ →", "Move around the map"],
  ["u", "Mark this note understood"],
  ["a", "Reveal or hide every answer"],
  ["m", "Sound on or off"],
  ["t", "Dark or light"],
  ["?", "This list"],
]
const RAINBOW = ["#ff5d5d", "#ff9f43", "#ffd93d", "#4ade80", "#5aa9ff", "#b388ff", "#ff5dac"]
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <link rel="icon" href="/icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Lessons" href="/rss.xml" />
    <script is:inline>
      document.documentElement.classList.add("js")
      try {
        const p = JSON.parse(localStorage.getItem("wiki:prefs")) || {}
        if (p.theme === "light") document.documentElement.dataset.theme = "light"
      } catch {}
    </script>
  </head>
  <body data-focus={note?.slug} data-lost={lost}>
    <div id="stage">
      <div id="world">
        <div id="regions"></div>
        <svg id="wires" aria-hidden="true">
          <defs>
            <linearGradient id="rainbow" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1400" y2="500" spreadMethod="reflect">
              {RAINBOW.map((c, i) => <stop offset={i / (RAINBOW.length - 1)} stop-color={c} />)}
            </linearGradient>
          </defs>
          <g id="edges"></g>
          <path id="trail"></path>
        </svg>
        <div id="cards"></div>
      </div>
    </div>

    <header class="hud bar">
      <a class="mark" href="/" data-home aria-label="Wiki: back to the whole map">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c1 7 5 11 12 12-7 1-11 5-12 12-1-7-5-11-12-12 7-1 11-5 12-12z"></path></svg>
        <b>Wiki</b>
        <span data-where>the map</span>
      </a>
      <button class="pill back" type="button" data-close>← Map <kbd>esc</kbd></button>
      <div class="q" id="q">
        <input type="search" placeholder="Search the map" autocomplete="off" spellcheck="false" aria-label="Search the map" />
        <kbd>/</kbd>
        <ul class="results" role="listbox"></ul>
      </div>
      <nav class="tools">
        <button type="button" data-sound aria-label="Sound on or off">♪</button>
        <button type="button" data-theme-toggle aria-label="Dark or light">◐</button>
        <button type="button" data-open-keys aria-label="Keyboard shortcuts">?</button>
      </nav>
    </header>

    <button class="hud pill today" type="button" data-today hidden></button>
    <nav class="hud zoom" aria-label="Zoom">
      <button type="button" data-zoom="-1" aria-label="Zoom out">−</button>
      <button type="button" data-fit>whole map</button>
      <button type="button" data-zoom="1" aria-label="Zoom in">+</button>
    </nav>
    <p class="hud hint">Drag to move · pinch or ⌘-scroll to zoom · click a card to fly in · <kbd>/</kbd> to search</p>

    {
      note && (
        <main id="seed">
          <h1>{note.title}</h1>
          <p class="lead">{note.lead}</p>
          <div class="body" set:html={cardBody(note)} />
        </main>
      )
    }

    <dialog id="keys" aria-label="Keyboard shortcuts">
      <div class="panel">
        <h2>Keys</h2>
        <dl>
          {
            KEYS.map(([key, what]) => (
              <>
                <dt>{key.split("  ").map((k) => <kbd>{k}</kbd>)}</dt>
                <dd>{what}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </dialog>

    <script>
      import "../scripts/app.ts"
    </script>
  </body>
</html>
