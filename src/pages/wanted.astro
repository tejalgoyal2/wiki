---
import Base from "../layouts/Base.astro"
import { wanted } from "../lib/wiki"

const edge = [...wanted].sort((a, b) => b[1].size - a[1].size)
---

<Base title="Wanted" description="Terms people looked for that have no note yet. The most wanted get written first.">
  <main>
    <article class="note">
      <header class="note-head">
        <h1>Wanted</h1>
        <p class="lead">
          Terms that have no note yet. Every search that comes up empty lands here, and the most wanted are written first,
          from primary sources, in the next daily run.
        </p>
      </header>
      <div class="prose">
        <h2>Asked for by readers</h2>
        <p class="wanted-list" data-wanted-live>Loading…</p>
        {
          edge.length > 0 && (
            <>
              <h2>Mentioned in notes, not written yet</h2>
              <p class="wanted-list">
                {edge.map(([term, from]) => (
                  <a class="term wanted" href={`/wanted/?q=${encodeURIComponent(term)}`} data-want={term}>
                    {term} <small>{from.size}</small>
                  </a>
                ))}
              </p>
            </>
          )
        }
        <p>
          Click a term for a quick draft from a small open model. Drafts are marked as unchecked and are replaced by a real
          note once it is written.
        </p>
      </div>
    </article>
  </main>
</Base>
