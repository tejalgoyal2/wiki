---
import Base from "../layouts/Base.astro"
import { notes, lessons, find, kind, day, TRACKS, type Note } from "../lib/wiki"

export const getStaticPaths = () =>
  notes.map((note) => ({ params: { slug: note.url.slice(1, -1) }, props: { note } }))

const { note } = Astro.props as { note: Note }
const isPage = note.type === "page"
const sources: string[] = note.data.sources ?? []
const host = (u: string) => {
  try {
    return new URL(u).hostname.replace(/^www\./, "")
  } catch {
    return u
  }
}
const puzzle = note.data.puzzle && find(note.data.puzzle)
const at = lessons.indexOf(note)
const [newer, older] = at >= 0 ? [lessons[at - 1], lessons[at + 1]] : []
const meta = [kind(note).toLowerCase(), TRACKS[note.data.track], !isPage && `${note.minutes} min read`].filter(Boolean)
---

<Base title={note.title} description={note.lead} slug={isPage ? undefined : note.slug}>
  <main>
    <article class="note hang" data-type={note.type}>
      <header class="note-head">
        <h1 class:list={{ long: note.title.length > 26 }}>{note.title.replace(/^#\d+\s*·\s*/, "")}</h1>
        {
          meta.length > 0 && (
            <p class="meta">
              {meta.map((m) => (
                <span>{m}</span>
              ))}
            </p>
          )
        }
        {note.lead && <p class="lead">{note.lead}</p>}
        {
          note.requires.length > 0 && (
            <nav class="before" aria-label="Read first">
              <i>Read first</i>
              {note.requires.map((r) => (
                <a href={r.url} data-slug={r.slug}>{r.title}</a>
              ))}
            </nav>
          )
        }
      </header>

      <div class="prose" set:html={note.html} />

      {
        !isPage && (
          <footer class="note-foot">
            <div class="gotit">
              <button type="button" data-gotit>
                I understand this
              </button>
              <span>Marks it on your map. Stays in this browser.</span>
            </div>

            {puzzle && (
              <section>
                <h2>Today's puzzle</h2>
                <ul class="links">
                  <li>
                    <a href={puzzle.url} data-slug={puzzle.slug}>{puzzle.title}</a>
                    <span>{puzzle.lead}</span>
                  </li>
                </ul>
              </section>
            )}

            {note.leadsTo.length > 0 && (
              <section>
                <h2>Leads to</h2>
                <ul class="links">
                  {note.leadsTo.map((n) => (
                    <li>
                      <a href={n.url} data-slug={n.slug}>{n.title}</a>
                      <span>{n.lead}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {note.mentionedIn.length > 0 && (
              <section>
                <h2>Mentioned in</h2>
                <p class="inline">
                  {note.mentionedIn.map((n) => (
                    <a href={n.url} data-slug={n.slug}>{n.title}</a>
                  ))}
                </p>
              </section>
            )}

            {sources.length > 0 && (
              <section>
                <h2>Sources</h2>
                <ul class="sources">
                  {sources.map((s) => (
                    <li>
                      <a href={s} rel="noopener">{host(s)}</a>
                      <span>{s.replace(/^https?:\/\/[^/]+/, "")}</span>
                    </li>
                  ))}
                </ul>
                <p class="checked">Last checked {day(note.data.updated)}. The sources are the authority, not this page.</p>
              </section>
            )}

            {(newer || older) && (
              <nav class="around">
                {older ? <a href={older.url}>← {older.title}</a> : <span />}
                {newer && <a href={newer.url}>{newer.title} →</a>}
              </nav>
            )}
          </footer>
        )
      }
    </article>
  </main>
</Base>
