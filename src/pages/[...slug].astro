---
// Every note has its own address. Opening it lands you on the map, already at that card.
import Map from "../layouts/Map.astro"
import { notes, type Note } from "../lib/wiki"

export const getStaticPaths = () => notes.map((note) => ({ params: { slug: note.url.slice(1, -1) }, props: { note } }))
const { note } = Astro.props as { note: Note }
---

<Map note={note} />
