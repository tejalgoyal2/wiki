---
import Base from "../layouts/Base.astro"
import { notes, lessons, ofType, find } from "../lib/wiki"

const today = lessons[0]
const puzzle = today?.data.puzzle && find(today.data.puzzle)
// The index: every note you can look up, as a word. Lessons are listed below instead.
const words = notes
  .filter((n) => !["page", "review", "lesson"].includes(n.type))
  .sort((a, b) => a.title.localeCompare(b.title))
const weight = (n: (typeof notes)[number]) => Math.min(12, n.requires.length + n.leadsTo.length + n.mentionedIn.length)
const plain = (t: string) => t.replace(/^#\d+\s*·\s*/, "")
---

<Base home>
  <main class="home">
    <section class="ask">
      <div class="q" id="hero-q">
        <label for="hq">What do you want to understand?</label>
        <div class="q-line">
          <input id="hq" type="search" placeholder="thread" autocomplete="off" spellcheck="false" />
          <span class="q-hint">press <kbd>/</kbd> to search</span>
        </div>
        <ul class="results" role="listbox"></ul>
      </div>
    </section>

    {
      today && (
        <p class="today-line">
          <i>Today's read</i>
          <a href={today.url}>{plain(today.title)}</a>
          <span>
            {today.minutes} minutes{puzzle && `, then a puzzle to think over: ${puzzle.title}`}.
          </span>
        </p>
      )
    }

    <section class="index">
      <header>
        <h2>Index</h2>
        <p data-you data-total={words.length}>{words.length} notes. Pale ones you haven't opened yet.</p>
      </header>
      <nav class="wall" aria-label="Every note">
        {
          words.map((n) => (
            <a href={n.url} data-slug={n.slug} data-d={n.lead} style={`--w:${weight(n)}`}>
              {n.title}
            </a>
          ))
        }
      </nav>
      <p class="define" data-define></p>
    </section>

    <section class="shelf">
      <h2>Paths</h2>
      <ul class="links">
        {ofType("path").map((p) => (
          <li>
            <a href={p.url} data-slug={p.slug}>{p.title}</a>
            <span>{p.lead}</span>
          </li>
        ))}
      </ul>
      <h2>Lessons</h2>
      <ul class="links">
        {lessons.map((l) => (
          <li>
            <a href={l.url} data-slug={l.slug}>{plain(l.title)}</a>
            <span>{l.lead}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>
